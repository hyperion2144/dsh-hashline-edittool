{
  "name": "dsh-hashline-edittool-client",
  "version": "0.1.1",
  "type": "module",
  "description": "Companion dsh web client plugin for dsh-hashline-edittool: renders hashline-branded read/edit tool cards (line:anchor gutters, applied multi-hunk diffs with anchor hints) from persisted presentationMeta. Issue #71 direction B.",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperion2144/dsh-hashline-edittool.git",
    "directory": "client"
  },
  "homepage": "https://github.com/hyperion2144/dsh-hashline-edittool#readme",
  "bugs": {
    "url": "https://github.com/hyperion2144/dsh-hashline-edittool/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "hashline",
    "web-ui",
    "client-plugin",
    "diff-card"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/verify-bundle.mjs",
    "verify": "node scripts/verify-bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
